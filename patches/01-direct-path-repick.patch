+#!/usr/bin/env node
+/**
+ * ตรวจ "การหยิบห้องอัตโนมัติที่ทุกคำขอแย่งห้องเดียวกัน" (room-pick-race)
+ *
+ * ทำไม (2026-10-01): การทดลองยิงคำขอจองพร้อมกันพบว่า ทุกคำขอที่หยิบห้องด้วย
+ * `ORDER BY rm.room_number LIMIT 1` ได้ห้องเลขน้อยสุดห้องเดียวกัน → คนแพ้ชนข้อจำกัด
+ * reservations_no_room_overlap แล้วถูกปฏิเสธ (หรือถูกส่งให้พนักงานจัดห้องเอง) ทั้งที่ยังมีห้องว่าง
+ * ข้อจำกัดในฐานข้อมูลกันขายซ้ำได้ครบ แต่ "ขายไม่ได้ทั้งที่ควรขายได้" ทดสอบทีละรายการไม่มีทางเจอ
+ *
+ * กติกา: ทุกคิวรีที่หยิบห้องอัตโนมัติแบบ ORDER BY rm.room_number LIMIT 1 ต้องมีอย่างใดอย่างหนึ่ง
+ *   ✅ `FOR UPDATE OF rm SKIP LOCKED` ในคิวรีเดียวกับ INSERT (ภายใน 8 บรรทัดถัดไป)
+ *   ✅ ป้ายกำกับ `room-pick-race: re-pick` ในคิวรี (ไฟล์นั้นต้องหยิบห้องใหม่และลองบันทึกซ้ำเมื่อชน 23P01)
+ *   หรืออยู่ใน KNOWN พร้อมเหตุผลว่าทำไมยอมรับได้
+ *
+ * รัน: node scripts/room-pick-race-check.mjs   (exit 1 ถ้าพบจุดใหม่)
+ */
+import { readFileSync, readdirSync, statSync } from "node:fs";
+import { join } from "node:path";
+
+// จำนวนจุดที่ยอมรับได้ต่อไฟล์ — ถ้าไฟล์ไหนมีจุดไม่ป้องกันเพิ่มขึ้นจากนี้ ตัวตรวจจะตก
+const KNOWN = {
+  // ย้ายห้องตอนแก้ไขการจองจาก OTA (applyOtaBookingEvent) — การจองเดียวกันถูกประมวลผลทีละ revision
+  // และถ้าชนจะลดระดับเป็นอัปเดตแบบปลอดภัย + แจ้งพนักงาน (โซนอันตราย Channex — แก้ต้องผ่าน cert)
+  "server/utils/channex.ts": 1,
+  // อัปเกรดห้องของแขกที่เข้าพักอยู่แล้ว — ทำทีละราย ไม่มีคำขอพร้อมกันจากหลายช่องทาง
+  "server/utils/room-upgrade.ts": 1,
+  // พนักงานจองหลายห้องในใบเดียว — พนักงานเห็นผลทันทีและเลือกห้องใหม่ได้
+  "server/routes/api/reservations/multi.post.ts": 1,
+  // walk-in ที่ตู้ — มีคนยืนหน้าตู้ทีละคน
+  "server/routes/api/kiosk/walkin.post.ts": 1,
+};
+
+function walk(d, out = []) { for (const f of readdirSync(d)) { const p = join(d, f); statSync(p).isDirectory() ? walk(p, out) : f.endsWith(".ts") && out.push(p); } return out; }
+const PICK = /ORDER BY [^\n]*rm\.room_number LIMIT 1/;
+const fails = [];
+let guarded = 0;
+for (const file of walk("server")) {
+  const lines = readFileSync(file, "utf8").split("\n");
+  let open = 0;
+  lines.forEach((line, i) => {
+    if (!PICK.test(line)) return;
+    const after = lines.slice(i, i + 9).join("\n");
+    const around = lines.slice(Math.max(0, i - 4), i + 4).join("\n");
+    if (/SKIP LOCKED/.test(after) || /room-pick-race: re-pick/.test(around)) { guarded++; return; }
+    open++;
+    if (open > (KNOWN[file] ?? 0)) fails.push(`${file}:${i + 1}  หยิบห้องอัตโนมัติโดยไม่มี SKIP LOCKED / re-pick`);
+  });
+}
+console.log(`room-pick-race-check: ${fails.length ? "❌ " + fails.length + " จุด" : `✅ ไม่พบจุดใหม่ (ป้องกันแล้ว ${guarded} จุด)`}`);
+for (const f of fails) console.log("  " + f);
+if (fails.length) process.exit(1);
